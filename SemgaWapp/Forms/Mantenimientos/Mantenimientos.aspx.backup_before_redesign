        function editarDistrito(id) {
            const tbody = $('#tblDistritos tbody');
            const row = tbody.find(`button[onclick="editarDistrito(${id})"]`).closest('tr');
            
            if (row.length === 0) {
                showToast('error', 'Error', 'No se encontró el distrito');
                return;
            }
            
            const cells = row.find('td');
            const codigo = cells.eq(1).find('span.badge').text() || cells.eq(1).text().trim();
            const codigoPais = cells.eq(2).find('span.badge.bg-info').text() || cells.eq(2).text().trim().split(' ')[0];
            const codigoProvincia = cells.eq(3).find('span.badge.bg-success').text() || cells.eq(3).text().trim().split(' ')[0];
            const descripcion = cells.eq(4).text().trim();
            
            $('#hdnIDDistrito').val(id);
            $('#txtCodigoDistrito').val(codigo); // Guardar código para edición
            $('#txtDescripcionDistrito').val(descripcion);
            $('#modalDistritoLabel').html('<i class="fas fa-map me-2"></i>Editar Distrito');
            
            const ddlPais = $('#ddlPaisDistrito');
            const ddlProvincia = $('#ddlProvinciaDistrito');
            
            // Destruir y reinicializar Select2 para país
            if (ddlPais.hasClass('select2-hidden-accessible')) {
                ddlPais.select2('destroy');
            }
            ddlPais.select2({
                theme: 'bootstrap-5',
                placeholder: 'Seleccione un país',
                allowClear: false,
                minimumResultsForSearch: 0,
                dropdownParent: $('#modalDistrito')
            });
            
            // Event listener para cuando se abre el dropdown de país
            ddlPais.off('select2:open').on('select2:open', function() {
                setTimeout(function() {
                    const searchField = $('#modalDistrito .select2-search__field');
                    if (searchField.length) {
                        searchField.prop('readonly', false).prop('disabled', false).focus();
                    }
                }, 100);
            });
            
            // Destruir y reinicializar Select2 para provincia
            if (ddlProvincia.hasClass('select2-hidden-accessible')) {
                ddlProvincia.select2('destroy');
            }
            ddlProvincia.select2({
                theme: 'bootstrap-5',
                placeholder: 'Seleccione una provincia',
                allowClear: false,
                minimumResultsForSearch: 0,
                dropdownParent: $('#modalDistrito')
            });
            
            // Event listener para cuando se abre el dropdown de provincia
            ddlProvincia.off('select2:open').on('select2:open', function() {
                setTimeout(function() {
                    const searchField = $('#modalDistrito .select2-search__field');
                    if (searchField.length) {
                        searchField.prop('readonly', false).prop('disabled', false).focus();
                    }
                }, 100);
            });
            
            // Establecer país y cargar provincias
            ddlPais.val(codigoPais).trigger('change.select2');
            
            // Esperar a que se carguen las provincias y luego establecer la provincia
            setTimeout(function() {
                ddlProvincia.val(codigoProvincia).trigger('change.select2');
            }, 200);
            
            $('#modalDistrito').modal('show');
        }

        function eliminarDistrito(id) {
            const tbody = $('#tblDistritos tbody');
            const row = tbody.find(`button[onclick="eliminarDistrito(${id})"]`).closest('tr');
            const descripcion = row.find('td').eq(4).text();
            
            mostrarConfirmEliminar(`Distrito "${descripcion}"`, function() {
                $.ajax({
                    type: "POST",
                    url: "Mantenimientos.aspx/EliminarDistrito",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({ id: id }),
                    dataType: "json",
                    success: function(response) {
                        let responseData = response.d;
                        if (typeof responseData === 'string') {
                            try {
                                responseData = JSON.parse(responseData);
                            } catch (parseError) {
                                showToast('error', 'Error', 'Error al procesar la respuesta del servidor');
                                return;
                            }
                        }
                        
                        if (responseData && responseData.Resultado === 'SUCCESS') {
                            showToast('success', 'Éxito', responseData.Mensaje || 'Distrito eliminado exitosamente');
                            cargarDistritos();
                        } else {
                            showToast('error', 'Error', responseData.Mensaje || 'Error al eliminar el distrito');
                        }
                    },
                    error: function(xhr, status, error) {
                        showToast('error', 'Error', 'Error al eliminar el distrito');
                    }
                });
            });
        }

        function guardarDistrito() {
            const codigoPais = $('#ddlPaisDistrito').val();
            const codigoProvincia = $('#ddlProvinciaDistrito').val();
            const descripcion = $('#txtDescripcionDistrito').val().trim();
            const id = $('#hdnIDDistrito').val();
            
            if (!codigoPais || !codigoProvincia || !descripcion) {
                showToast('warning', 'Validación', 'Todos los campos son requeridos');
                return;
            }
            
            // Para edición, el código es requerido; para creación, se genera automáticamente
            const codigo = $('#txtCodigoDistrito').val().trim();
            const distritoData = {
                ID: id || null,
                Code: (id && id !== '' && codigo) ? parseInt(codigo) : null, // Solo enviar código si es edición
                CodePais: codigoPais,
                CodeProvincia: parseInt(codigoProvincia),
                Descripcion: descripcion
            };
            
            $('#btnGuardarDistrito').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Guardando...');
            
            $.ajax({
                type: "POST",
                url: "Mantenimientos.aspx/GuardarDistrito",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ distritoData: distritoData }),
                dataType: "json",
                success: function(response) {
                    let responseData = response.d;
                    if (typeof responseData === 'string') {
                        try {
                            responseData = JSON.parse(responseData);
                        } catch (parseError) {
                            showToast('error', 'Error', 'Error al procesar la respuesta del servidor');
                            return;
                        }
                    }
                    
                    if (responseData && responseData.Resultado === 'SUCCESS') {
                        showToast('success', 'Éxito', responseData.Mensaje || 'Distrito guardado exitosamente');
                        $('#modalDistrito').modal('hide');
                        cargarDistritos();
                    } else {
                        const mensajeError = responseData.Mensaje || 'Error al guardar el distrito';
                        showToast('error', 'Error', mensajeError);
                        if (mensajeError.includes('código ingresado ya existe') || mensajeError.includes('duplicate key')) {
                            $('#txtCodigoDistrito').focus().select();
                        }
                    }
                },
                error: function(xhr, status, error) {
                    showToast('error', 'Error', 'Error al guardar el distrito');
                },
                complete: function() {
                    $('#btnGuardarDistrito').prop('disabled', false).html('<i class="fas fa-save me-1"></i>Guardar');
                }
            });
        }

