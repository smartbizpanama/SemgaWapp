        function cargarCorregimientos() {
            const filtros = {};
            
            const code = $('#txtFiltroCodigoCorregimiento').val();
            if (code && code.trim() !== '') {
                filtros.Code = code;
            }
            
            const codePais = $('#ddlFiltroPaisCorregimiento').val();
            if (codePais && codePais.trim() !== '') {
                filtros.CodePais = codePais;
            }
            
            const codeProvincia = $('#ddlFiltroProvinciaCorregimiento').val();
            if (codeProvincia && codeProvincia.trim() !== '') {
                filtros.CodeProvincia = codeProvincia;
            }
            
            const codeDistrito = $('#ddlFiltroDistritoCorregimiento').val();
            if (codeDistrito && codeDistrito.trim() !== '') {
                filtros.CodeDistrito = codeDistrito;
            }
            
            const descripcion = $('#txtFiltroDescripcionCorregimiento').val();
            if (descripcion && descripcion.trim() !== '') {
                filtros.Descripcion = descripcion;
            }
            
            $.ajax({
                type: "POST",
                url: "Mantenimientos.aspx/ListarCorregimientos",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ filtrosJson: JSON.stringify(filtros) }),
                dataType: "json",
                success: function(response) {
                    let responseData = response.d;
                    if (typeof responseData === 'string') {
                        try {
                            responseData = JSON.parse(responseData);
                        } catch (e) {
                            console.error('Error al parsear respuesta:', e);
                            showToast('error', 'Error', 'Error al procesar la respuesta del servidor');
                            return;
                        }
                    }
                    
                    if (responseData && responseData.Success) {
                        mostrarCorregimientos(responseData.Data);
                    } else {
                        const mensajeError = responseData ? (responseData.Message || 'Error al cargar corregimientos') : 'Error al cargar corregimientos';
                        if (mensajeError !== 'Error al cargar corregimientos') {
                            showToast('error', 'Error', mensajeError);
                        }
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error AJAX al cargar corregimientos:', {
                        status: status,
                        error: error,
                        responseText: xhr.responseText
                    });
                    // Solo mostrar error si no es un error de parseo que ya se manejó
                    if (xhr.status !== 200 || !xhr.responseText) {
                        showToast('error', 'Error', 'Error al cargar corregimientos');
                    }
                }
            });
        }

        function crearChipCodigoDescripcion(codigo, descripcion, color = 'bg-primary') {
            if (!codigo && !descripcion) {
                return '<span class="badge bg-secondary">-</span>';
            }
            const codigoStr = codigo ? String(codigo) : '';
            const descripcionStr = descripcion ? String(descripcion) : '';
            
            if (codigoStr && descripcionStr) {
                return `<span class="badge ${color} me-1">${codigoStr}</span><span class="text-muted">${descripcionStr}</span>`;
            } else if (codigoStr) {
                return `<span class="badge ${color}">${codigoStr}</span>`;
            } else if (descripcionStr) {
                return `<span class="text-muted">${descripcionStr}</span>`;
            }
            return '<span class="badge bg-secondary">-</span>';
        }

        function mostrarCorregimientos(corregimientos) {
            const tbody = $('#tblCorregimientos tbody');
            tbody.empty();
            
            if (corregimientos && corregimientos.length > 0) {
                corregimientos.forEach(function(corregimiento) {
                    const paisChip = crearChipCodigoDescripcion(corregimiento.CodePais || '', corregimiento.PaisDescripcion || '', 'bg-info');
                    const provinciaChip = crearChipCodigoDescripcion(corregimiento.CodeProvincia || '', corregimiento.ProvinciaDescripcion || '', 'bg-success');
                    const distritoChip = crearChipCodigoDescripcion(corregimiento.CodeDistrito || '', corregimiento.DistritoDescripcion || '', 'bg-warning');
                    
                    tbody.append(`
                        <tr>
                            <td>${corregimiento.ID || ''}</td>
                            <td>${corregimiento.Code || ''}</td>
                            <td>${paisChip}</td>
                            <td>${provinciaChip}</td>
                            <td>${distritoChip}</td>
                            <td>${corregimiento.Descripcion || ''}</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="editarCorregimiento(${corregimiento.ID}, ${corregimiento.Code}, '${corregimiento.CodePais}', ${corregimiento.CodeProvincia}, ${corregimiento.CodeDistrito}, '${corregimiento.Descripcion.replace(/'/g, "\\'")}')" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarCorregimiento(${corregimiento.ID}, '${corregimiento.Descripcion.replace(/'/g, "\\'")}')" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    `);
                });
            } else {
                tbody.append('<tr><td colspan="7" class="text-center">No se encontraron corregimientos</td></tr>');
            }
        }

        function configurarEventosCorregimientos() {
            $('#btnNuevoCorregimiento').off('click').on('click', function() {
                limpiarFormularioCorregimiento();
                $('#modalCorregimientoLabel').html('<i class="fas fa-map-pin me-2"></i>Nuevo Corregimiento');
                
                if ($('#ddlPaisCorregimiento option').length <= 1) {
                    cargarPaisesParaCorregimientos();
                }
                
                $('#modalCorregimiento').modal('show');
                
                $('#modalCorregimiento').one('shown.bs.modal', function() {
                    const ddlPais = $('#ddlPaisCorregimiento');
                    const ddlProvincia = $('#ddlProvinciaCorregimiento');
                    const ddlDistrito = $('#ddlDistritoCorregimiento');
                    
                    // Destruir y reinicializar Select2 para país
                    if (ddlPais.hasClass('select2-hidden-accessible')) {
                        ddlPais.select2('destroy');
                    }
                    ddlPais.select2({
                        theme: 'bootstrap-5',
                        placeholder: 'Seleccione un país',
                        allowClear: false,
                        minimumResultsForSearch: 0,
                        dropdownParent: $('#modalCorregimiento')
                    });
                    
                    // Event listener para cuando se abre el dropdown de país
                    ddlPais.off('select2:open').on('select2:open', function() {
                        setTimeout(function() {
                            const searchField = $('#modalCorregimiento .select2-search__field');
                            if (searchField.length) {
                                searchField.prop('readonly', false).prop('disabled', false).focus();
                            }
                        }, 100);
                    });
                    
                    // Destruir y reinicializar Select2 para provincia
                    if (ddlProvincia.hasClass('select2-hidden-accessible')) {
                        ddlProvincia.select2('destroy');
                    }
                    ddlProvincia.select2({
                        theme: 'bootstrap-5',
                        placeholder: 'Seleccione una provincia',
                        allowClear: false,
                        minimumResultsForSearch: 0,
                        dropdownParent: $('#modalCorregimiento')
                    });
                    
                    // Event listener para cuando se abre el dropdown de provincia
                    ddlProvincia.off('select2:open').on('select2:open', function() {
                        setTimeout(function() {
                            const searchField = $('#modalCorregimiento .select2-search__field');
                            if (searchField.length) {
                                searchField.prop('readonly', false).prop('disabled', false).focus();
                            }
                        }, 100);
                    });
                    
                    // Destruir y reinicializar Select2 para distrito
                    if (ddlDistrito.hasClass('select2-hidden-accessible')) {
                        ddlDistrito.select2('destroy');
                    }
                    ddlDistrito.select2({
                        theme: 'bootstrap-5',
                        placeholder: 'Seleccione un distrito',
                        allowClear: false,
                        minimumResultsForSearch: 0,
                        dropdownParent: $('#modalCorregimiento')
                    });
                    
                    // Event listener para cuando se abre el dropdown de distrito
                    ddlDistrito.off('select2:open').on('select2:open', function() {
                        setTimeout(function() {
                            const searchField = $('#modalCorregimiento .select2-search__field');
                            if (searchField.length) {
                                searchField.prop('readonly', false).prop('disabled', false).focus();
                            }
                        }, 100);
                    });
                    
                    // Establecer Panamá como valor por defecto
                    ddlPais.val('PA').trigger('change.select2');
                    
                    // Cargar provincias de Panamá automáticamente sin seleccionar ninguna
                    cargarProvinciasPorPaisParaCorregimiento('PA');
                    
                    // Enfocar en descripción después de cargar todo
                    setTimeout(function() {
                        $('#txtDescripcionCorregimiento').focus();
                    }, 500);
                });
            });
            
            // Event listeners para cascada en el modal
            $('#ddlPaisCorregimiento').off('change.corregimiento').on('change.corregimiento', function() {
                const codigoPais = $(this).val();
                $('#ddlProvinciaCorregimiento').empty().append('<option value="">Primero seleccione un país</option>').prop('disabled', true).trigger('change.select2');
                $('#ddlDistritoCorregimiento').empty().append('<option value="">Primero seleccione una provincia</option>').prop('disabled', true).trigger('change.select2');
                if (codigoPais) {
                    cargarProvinciasPorPaisParaCorregimiento(codigoPais);
                }
            });
            
            $('#ddlProvinciaCorregimiento').off('change.corregimiento').on('change.corregimiento', function() {
                const codigoPais = $('#ddlPaisCorregimiento').val();
                const codigoProvincia = $(this).val();
                $('#ddlDistritoCorregimiento').empty().append('<option value="">Primero seleccione una provincia</option>').prop('disabled', true).trigger('change.select2');
                if (codigoPais && codigoProvincia) {
                    cargarDistritosPorProvinciaParaCorregimiento(codigoPais, codigoProvincia);
                }
            });
            
            $('#btnBuscarCorregimientos').off('click').on('click', function() {
                cargarCorregimientos();
            });
            
            $('#btnLimpiarFiltrosCorregimiento').off('click').on('click', function() {
                limpiarFiltrosCorregimiento();
            });
            
            $('#btnGuardarCorregimiento').off('click').on('click', function() {
                guardarCorregimiento();
            });
        }

        function limpiarFiltrosCorregimiento() {
            $('#txtFiltroCodigoCorregimiento').val('');
            $('#ddlFiltroPaisCorregimiento').val('');
            $('#ddlFiltroProvinciaCorregimiento').val('');
            $('#ddlFiltroDistritoCorregimiento').val('');
            $('#txtFiltroDescripcionCorregimiento').val('');
            cargarCorregimientos();
        }

        function limpiarFormularioCorregimiento() {
            $('#hdnIDCorregimiento').val('');
            $('#txtCodigoCorregimiento').val('');
            $('#ddlPaisCorregimiento').val('').trigger('change.select2');
            $('#ddlProvinciaCorregimiento').empty().append('<option value="">Primero seleccione un país</option>').prop('disabled', true).trigger('change.select2');
            $('#ddlDistritoCorregimiento').empty().append('<option value="">Primero seleccione una provincia</option>').prop('disabled', true).trigger('change.select2');
            $('#txtDescripcionCorregimiento').val('');
        }

        function editarCorregimiento(id, codigo, codigoPais, codigoProvincia, codigoDistrito, descripcion) {
            $('#hdnIDCorregimiento').val(id);
            $('#txtCodigoCorregimiento').val(codigo);
            $('#txtDescripcionCorregimiento').val(descripcion);
            $('#modalCorregimientoLabel').html('<i class="fas fa-map-pin me-2"></i>Editar Corregimiento');
            
            const ddlPais = $('#ddlPaisCorregimiento');
            const ddlProvincia = $('#ddlProvinciaCorregimiento');
            const ddlDistrito = $('#ddlDistritoCorregimiento');
            
            // Destruir y reinicializar Select2
            if (ddlPais.hasClass('select2-hidden-accessible')) {
                ddlPais.select2('destroy');
            }
            ddlPais.select2({
                theme: 'bootstrap-5',
                placeholder: 'Seleccione un país',
                allowClear: false,
                minimumResultsForSearch: 0,
                dropdownParent: $('#modalCorregimiento')
            });
            
            // Event listener para cuando se abre el dropdown de país
            ddlPais.off('select2:open').on('select2:open', function() {
                setTimeout(function() {
                    const searchField = $('#modalCorregimiento .select2-search__field');
                    if (searchField.length) {
                        searchField.prop('readonly', false).prop('disabled', false).focus();
                    }
                }, 100);
            });
            
            $('#modalCorregimiento').modal('show');
            $('#modalCorregimiento').one('shown.bs.modal', function() {
                ddlPais.val(codigoPais).trigger('change.select2');
                
                setTimeout(function() {
                    cargarProvinciasPorPaisParaCorregimiento(codigoPais);
                    setTimeout(function() {
                        ddlProvincia.val(codigoProvincia).trigger('change.select2');
                        setTimeout(function() {
                            cargarDistritosPorProvinciaParaCorregimiento(codigoPais, codigoProvincia);
                            setTimeout(function() {
                                ddlDistrito.val(codigoDistrito).trigger('change.select2');
                            }, 300);
                        }, 300);
                    }, 300);
                }, 300);
            });
        }

        function eliminarCorregimiento(id, descripcion) {
            mostrarConfirmEliminar(`Corregimiento "${descripcion}"`, function() {
                $.ajax({
                    type: "POST",
                    url: "Mantenimientos.aspx/EliminarCorregimiento",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({ id: id }),
                    dataType: "json",
                    success: function(response) {
                        if (typeof response.d === 'string') {
                            response.d = JSON.parse(response.d);
                        }
                        if (response.d && response.d.Resultado === 'SUCCESS') {
                            showToast('success', 'Éxito', response.d.Mensaje || 'Corregimiento eliminado exitosamente');
                            cargarCorregimientos();
                        } else {
                            showToast('error', 'Error', response.d.Mensaje || 'Error al eliminar el corregimiento');
                        }
                    },
                    error: function() {
                        showToast('error', 'Error', 'Error al eliminar el corregimiento');
                    }
                });
            });
        }

        function guardarCorregimiento() {
            const id = $('#hdnIDCorregimiento').val();
            const codigo = $('#txtCodigoCorregimiento').val();
            const codigoPais = $('#ddlPaisCorregimiento').val();
            const codigoProvincia = $('#ddlProvinciaCorregimiento').val();
            const codigoDistrito = $('#ddlDistritoCorregimiento').val();
            const descripcion = $('#txtDescripcionCorregimiento').val().trim();
            
            if (!codigoPais || !codigoProvincia || !codigoDistrito || !descripcion) {
                showToast('warning', 'Validación', 'Todos los campos son requeridos');
                return;
            }
            
            // Para UPDATE, el código es requerido
            if (id && id !== '' && id !== '0') {
                if (!codigo || codigo === '' || parseInt(codigo) <= 0) {
                    showToast('warning', 'Validación', 'El código es requerido y debe ser mayor a cero para actualizar');
                    return;
                }
            }
            
            $('#btnGuardarCorregimiento').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Guardando...');
            
            const corregimientoData = {
                ID: id && id !== '' ? parseInt(id) : null,
                Code: codigo && codigo !== '' ? parseInt(codigo) : null,
                CodePais: codigoPais,
                CodeProvincia: parseInt(codigoProvincia),
                CodeDistrito: parseInt(codigoDistrito),
                Descripcion: descripcion
            };
            
            $.ajax({
                type: "POST",
                url: "Mantenimientos.aspx/GuardarCorregimiento",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ corregimientoDataJson: JSON.stringify(corregimientoData) }),
                dataType: "json",
                success: function(response) {
                    let responseData = response.d;
                    if (typeof responseData === 'string') {
                        try {
                            responseData = JSON.parse(responseData);
                        } catch (e) {
                            console.error('Error al parsear respuesta:', e);
                            responseData = { Resultado: 'ERROR', Mensaje: 'Error al procesar la respuesta del servidor' };
                        }
                    }
                    
                    if (responseData && responseData.Resultado === 'SUCCESS') {
                        showToast('success', 'Éxito', responseData.Mensaje || 'Corregimiento guardado exitosamente');
                        $('#modalCorregimiento').modal('hide');
                        cargarCorregimientos();
                    } else {
                        const mensajeError = responseData.Mensaje || 'Error al guardar el corregimiento';
                        showToast('error', 'Error', mensajeError);
                        if (mensajeError.includes('código ingresado ya existe') || mensajeError.includes('duplicate key')) {
                            $('#txtCodigoCorregimiento').focus().select();
                        }
                    }
                },
                error: function(xhr, status, error) {
                    showToast('error', 'Error', 'Error al guardar el corregimiento');
                },
                complete: function() {
                    $('#btnGuardarCorregimiento').prop('disabled', false).html('<i class="fas fa-save me-1"></i>Guardar');
                }
            });
        }

    </script>

