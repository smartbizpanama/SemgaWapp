                valido = false;
            }
            
            if (!$('#ddlDebCred').val()) {
                $('#ddlDebCred').addClass('is-invalid');
                valido = false;
            }
            
            if (!valido) {
                showToast('warning', 'Validación', 'Por favor complete todos los campos requeridos');
