                            ddlDistrito.off('select2:open').on('select2:open', function() {
                                setTimeout(function() {
                                    const searchField = $('#modalCorregimiento .select2-search__field');
                                    if (searchField.length) {
                                        searchField.prop('readonly', false).prop('disabled', false).focus();
                                    }
                                }, 100);
                            });
                        } catch (parseError) {
                            console.error('Error al parsear datos de distritos:', parseError);
                        }
                    } else if (responseData && responseData.Resultado === 'ERROR') {
                        console.error('Error del servidor al cargar distritos:', responseData.Mensaje);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error AJAX al cargar distritos:', error, xhr.responseText);
                }
            });
        }

        function cargarProvinciasParaFiltroCorregimientos() {
            $.ajax({
                type: "POST",
                url: "Mantenimientos.aspx/ListarProvincias",
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ filtros: {} }),
                dataType: "json",
                success: function(response) {
                    let responseData = response.d;
                    if (typeof responseData === 'string') {
                        try {
                            responseData = JSON.parse(responseData);
                        } catch (parseError) {
                            console.error('Error al parsear respuesta de provincias para filtro:', parseError);
                            return;
                        }
                    }
                    
                    if (responseData && responseData.Resultado === 'SUCCESS') {
                        try {
                            const provincias = JSON.parse(responseData.Datos);
                            const ddlFiltro = $('#ddlFiltroProvinciaCorregimiento');
                            ddlFiltro.empty().append('<option value="">Todas</option>');
                            provincias.forEach(function(provincia) {
                                ddlFiltro.append(`<option value="${provincia.Code}">${provincia.Code} - ${provincia.Descripcion}</option>`);
                            });
                        } catch (parseError) {
                            console.error('Error al parsear datos de provincias para filtro:', parseError);
                        }
                    } else if (responseData && responseData.Resultado === 'ERROR') {
                        console.error('Error del servidor al cargar provincias para filtro:', responseData.Mensaje);
                        // No mostrar toast si es solo para filtros
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error AJAX al cargar provincias para filtro:', error, xhr.responseText);
                    // No mostrar toast si es solo para filtros
                }
            });
        }

